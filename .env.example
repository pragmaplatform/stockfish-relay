# Configuration is read from the process environment, not automatically from this file.
# Generate separate keys with: openssl rand -hex 32
STOCKFISH_RELAY_API_KEY=replace-with-a-random-client-key
STOCKFISH_RELAY_WORKER_KEY=replace-with-a-different-random-worker-key

# Master
STOCKFISH_RELAY_LISTEN=127.0.0.1:8080
STOCKFISH_RELAY_QUEUE_CAPACITY=128
STOCKFISH_RELAY_MAX_ATTEMPTS=3
STOCKFISH_RELAY_LEASE_MS=15000
STOCKFISH_RELAY_LONG_POLL_MS=20000
STOCKFISH_RELAY_REQUEST_TIMEOUT_MS=120000
STOCKFISH_RELAY_SEARCH_TIMEOUT_MS=30000
STOCKFISH_RELAY_DEFAULT_NODES=1000000
STOCKFISH_RELAY_MAX_NODES=50000000
STOCKFISH_RELAY_MAX_DEPTH=40
STOCKFISH_RELAY_MAX_MULTIPV=5

# Worker: the master URL includes the scheme, hostname, and port.
STOCKFISH_RELAY_MASTER_URL=http://127.0.0.1:8080
STOCKFISH_RELAY_WORKER_NAME=ci-server
STOCKFISH_RELAY_CONCURRENCY=1
STOCKFISH_PATH=/opt/stockfish/stockfish
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=64
RUST_LOG=info
